# ==============================================================================
# PASHURAKSHA (पशुरक्षा) — ENVIRONMENT VARIABLES TEMPLATE
# Tagline: "Detect Early. Prevent Outbreaks. Protect Livestock."
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' in your local development environment:
#      cp .env.example .env.local
# 2. Fill in your project credentials from your Supabase Dashboard:
#      https://supabase.com/dashboard/project/<project-ref>/settings/api
# 3. DO NOT commit '.env.local' or any file containing real API keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLIENT CONFIGURATION (PUBLIC / CLIENT-SIDE SAFE)
# ------------------------------------------------------------------------------
# Your Supabase Project API URL (HTTPS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (safe for browser exposure with RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# ------------------------------------------------------------------------------
# 2. APPLICATION METADATA & ENVIRONMENT
# ------------------------------------------------------------------------------
VITE_APP_ENV=development
VITE_APP_NAME="PashuRaksha Livestock Health Platform"
VITE_APP_VERSION=1.0.0

# ------------------------------------------------------------------------------
# 3. SECURITY WARNING — CRITICAL
# ------------------------------------------------------------------------------
# DO NOT add SUPABASE_SERVICE_ROLE_KEY to this file or any client VITE_ variable!
# The service-role key bypasses all Row Level Security (RLS) policies and MUST
# strictly remain on secure backend environments (e.g. Supabase Edge Functions).
# ------------------------------------------------------------------------------
